{
  "name": "@foldocs/cli",
  "version": "0.1.2",
  "description": "Authoring, validation, customization, tree, component, and preview commands for Foldocs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarkaworks/foldocs",
    "directory": "packages/cli"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "foldocs": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "effect": "4.0.0-beta.102",
    "foldocs-mdx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
