{
  "name": "foldocs-ui",
  "version": "0.1.2",
  "description": "Foldkit-native documentation layouts, navigation, and deterministic Markdown components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarkaworks/foldocs",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@foldkit/markdown": "0.2.1",
    "@foldkit/ui": "0.137.0",
    "@foldocs/content": "workspace:*",
    "@foldocs/search": "workspace:*",
    "effect": "4.0.0-beta.102",
    "foldkit": "^0.137.0",
    "foldocs-core": "workspace:*",
    "foldocs-mdx": "workspace:*",
    "lucide": "0.547.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.102",
    "foldkit": "^0.137.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
