{
  "name": "@foldocs/vite",
  "version": "0.1.2",
  "description": "Vite plugin for Foldocs content compilation, routes, SEO assets, search indices, and static output.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarkaworks/foldocs",
    "directory": "packages/vite"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "client.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@foldocs/content": "workspace:*",
    "@foldocs/typescript": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "foldocs-core": "workspace:*",
    "foldocs-mdx": "workspace:*",
    "foldocs-ui": "workspace:*",
    "takumi-js": "^2.5.4"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
