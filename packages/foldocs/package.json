{
  "name": "foldocs",
  "version": "0.1.2",
  "description": "The beautiful and flexible Foldkit documentation framework, powered by Effect.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarkaworks/foldocs",
    "directory": "packages/foldocs"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@foldocs/ai": "workspace:*",
    "@foldocs/content": "workspace:*",
    "@foldocs/search": "workspace:*",
    "@foldocs/search-orama": "workspace:*",
    "foldocs-core": "workspace:*",
    "foldocs-mdx": "workspace:*",
    "foldocs-ui": "workspace:*",
    "mermaid": "^11.12.0"
  },
  "peerDependencies": {
    "@foldkit/ui": "^0.137.0",
    "effect": "4.0.0-beta.102",
    "foldkit": "^0.137.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
