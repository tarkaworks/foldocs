{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["@effectdocs/vite/client", "vite/client"]
  },
  "include": ["src", "content", "effectdocs.config.ts", "vite.config.ts"]
}
