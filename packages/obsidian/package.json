{
  "name": "@foldocs/obsidian",
  "version": "0.1.0",
  "description": "Convert an Obsidian vault into deterministic Foldocs Markdown pages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarkaworks/foldocs",
    "directory": "packages/obsidian"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "foldocs-obsidian": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "foldocs-mdx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
