{
  "name": "@foldocs/epub",
  "version": "0.0.0",
  "description": "Export Foldocs Markdown and MDX content as a portable EPUB publication.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarkaworks/foldocs",
    "directory": "packages/epub"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "foldocs-epub": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "foldocs-mdx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
