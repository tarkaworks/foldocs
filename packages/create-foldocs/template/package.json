{
  "name": "__FOLDOCS_PACKAGE_NAME__",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "test": "vitest run",
    "docs:check": "foldocs check --locales en,es --fallback-locale en",
    "check": "prettier --check . && oxlint --disable-nested-config && tsc --noEmit && vitest run && foldocs check --locales en,es --fallback-locale en"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.102",
    "@foldkit/markdown": "0.2.1",
    "effect": "4.0.0-beta.102",
    "foldocs": "latest",
    "foldkit": "0.137.0"
  },
  "devDependencies": {
    "@foldocs/cli": "latest",
    "@foldocs/language": "latest",
    "@foldocs/tailwind": "latest",
    "@foldocs/twoslash": "latest",
    "@foldocs/vite": "latest",
    "@foldkit/devtools": "0.137.0",
    "@foldkit/devtools-mcp": "0.14.0",
    "@foldkit/oxlint-plugin": "0.5.0",
    "@foldkit/vite-plugin": "0.11.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "latest",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.76.0",
    "prettier": "^3.8.4",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.9"
  }
}
