{
  "name": "__FOLDOCS_PACKAGE_NAME__",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "alchemy dev",
    "build": "tsc --noEmit && vite build",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "check": "foldocs check --locales en,es --fallback-locale en",
    "generate:api": "foldocs-openapi openapi.yaml content/docs/en/api /en/docs/api",
    "generate:events": "foldocs-asyncapi asyncapi.yaml content/docs/en/events /en/docs/events",
    "export:epub": "foldocs-epub content/docs/en dist/documentation.epub Documentation urn:foldocs:documentation",
    "import:obsidian": "foldocs-obsidian vault content/docs/en/notes"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.102",
    "@foldkit/markdown": "0.2.1",
    "effect": "4.0.0-beta.102",
    "foldocs": "latest",
    "foldkit": "0.137.0"
  },
  "devDependencies": {
    "@foldocs/asyncapi": "latest",
    "@foldocs/cli": "latest",
    "@foldocs/epub": "latest",
    "@foldocs/language": "latest",
    "@foldocs/obsidian": "latest",
    "@foldocs/openapi": "latest",
    "@foldocs/tailwind": "latest",
    "@foldocs/twoslash": "latest",
    "@foldocs/vite": "latest",
    "@foldkit/devtools": "0.137.0",
    "@foldkit/devtools-mcp": "0.14.0",
    "@foldkit/oxlint-plugin": "0.5.0",
    "@foldkit/vite-plugin": "0.11.3",
    "@types/node": "latest",
    "alchemy": "0.93.12",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.76.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.9"
  }
}
