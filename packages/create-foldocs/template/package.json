{
  "name": "__FOLDOCS_PACKAGE_NAME__",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "foldocs check --locales en,es --fallback-locale en",
    "generate:api": "foldocs-openapi openapi.yaml content/docs/en/api /en/docs/api",
    "generate:events": "foldocs-asyncapi asyncapi.yaml content/docs/en/events /en/docs/events",
    "export:epub": "foldocs-epub content/docs/en dist/documentation.epub Documentation urn:foldocs:documentation",
    "import:obsidian": "foldocs-obsidian vault content/docs/en/notes"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "foldocs": "latest",
    "foldkit": "0.130.0"
  },
  "devDependencies": {
    "@foldocs/asyncapi": "latest",
    "@foldocs/cli": "latest",
    "@foldocs/epub": "latest",
    "@foldocs/language": "latest",
    "@foldocs/obsidian": "latest",
    "@foldocs/openapi": "latest",
    "@foldocs/tailwind": "latest",
    "@foldocs/twoslash": "latest",
    "@foldocs/vite": "latest",
    "@foldkit/vite-plugin": "0.11.0",
    "@types/node": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
