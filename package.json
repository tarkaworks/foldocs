{
  "name": "foldocs-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "deploy": "alchemy deploy",
    "dev": "turbo run dev --parallel",
    "dev:cloudflare": "alchemy dev",
    "destroy": "alchemy destroy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint apps packages e2e",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter foldocs-docs build && playwright test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.0-beta.102",
    "@foldkit/devtools": "0.137.0",
    "@foldkit/devtools-mcp": "0.14.0",
    "@foldkit/oxlint-plugin": "0.5.0",
    "@foldkit/ui": "0.137.0",
    "@foldkit/vite-plugin": "0.11.3",
    "@playwright/test": "^1.61.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.1.1",
    "alchemy": "0.93.12",
    "effect": "4.0.0-beta.102",
    "foldkit": "0.137.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.8.4",
    "turbo": "^2.5.8",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
