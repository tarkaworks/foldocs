{
  "name": "foldocs-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "foldocs check --locales en,es --fallback-locale en",
    "generate:api": "foldocs-openapi openapi.yaml content/docs/en/api /en/docs/api",
    "generate:events": "foldocs-asyncapi asyncapi.yaml content/docs/en/events /en/docs/events",
    "generate:typescript": "foldocs-typescript reference.ts content/docs/en/typescript /en/docs/typescript",
    "generate:python": "foldocs-python reference.py content/docs/en/python /en/docs/python",
    "export:epub": "foldocs-epub content/docs/en dist/foldocs.epub Foldocs urn:foldocs:documentation",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "foldocs": "workspace:*",
    "foldkit": "0.130.0"
  },
  "devDependencies": {
    "@foldocs/asyncapi": "workspace:*",
    "@foldocs/cli": "workspace:*",
    "@foldocs/epub": "workspace:*",
    "@foldocs/language": "workspace:*",
    "@foldocs/obsidian": "workspace:*",
    "@foldocs/openapi": "workspace:*",
    "@foldocs/tailwind": "workspace:*",
    "@foldocs/twoslash": "workspace:*",
    "@foldocs/typescript": "workspace:*",
    "@foldocs/python": "workspace:*",
    "@foldocs/vite": "workspace:*",
    "@foldkit/vite-plugin": "0.11.0",
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
